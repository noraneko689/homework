#include <iostream>
#include <vector>
#include <memory>
#include <stdexcept>
#include <cmath>

class ShapeException : public std::runtime_error {
public:
    ShapeException(const std::string& message) : std::runtime_error(message) {}
};

template<typename T>
struct Point {
    T x, y;

    Point(T x = T(), T y = T()) : x(x), y(y) {}

    double distance(const Point<T>& other) const {
        return std::sqrt(std::pow(x - other.x, 2) + std::pow(y - other.y, 2));
    }

    friend std::ostream& operator<<(std::ostream& os, const Point<T>& point) {
        os << "(" << point.x << ", " << point.y << ")";
        return os;
    }
};

class Shape {
public:
    virtual ~Shape() = default;
    virtual double area() const = 0;
    virtual void printInfo(std::ostream& os) const = 0;
    static int getTotalShapes() { return totalShapes; }

protected:
    static int totalShapes;
    Shape() { totalShapes++; }
    Shape(const Shape&) { totalShapes++; }
};

int Shape::totalShapes = 0;

template<typename T>
class Polygon : public Shape {
protected:
    std::vector<Point<T>> points;
    static int polygonCount;

    virtual void validate() const {
        if (points.size() < 3) {
            throw ShapeException("Polygon must have at least 3 points");
        }

        for (size_t i = 0; i < points.size() - 2; ++i) {
            Point<T> p1 = points[i];
            Point<T> p2 = points[i + 1];
            Point<T> p3 = points[i + 2];

            T area = (p2.x - p1.x) * (p3.y - p1.y) - (p3.x - p1.x) * (p2.y - p1.y);
            if (area == 0) {
                throw ShapeException("Polygon has collinear points");
            }
        }
    }

public:
    Polygon() { polygonCount++; }

    Polygon(const std::vector<Point<T>>& points) : points(points) {
        polygonCount++;
        validate();
    }

    Polygon(const Polygon<T>& other) : points(other.points) {
        polygonCount++;
    }

    virtual ~Polygon() {
        polygonCount--;
    }

    Polygon<T>& operator=(const Polygon<T>& other) {
        if (this != &other) {
            points = other.points;
        }
        return *this;
    }

    void addPoint(const Point<T>& point) {
        points.push_back(point);
        validate();
    }

    double area() const override {
        if (points.size() < 3) return 0.0;

        double area = 0.0;
        for (size_t i = 0; i < points.size(); ++i) {
            const Point<T>& p1 = points[i];
            const Point<T>& p2 = points[(i + 1) % points.size()];
            area += (p1.x * p2.y - p2.x * p1.y);
        }
        return std::abs(area) / 2.0;
    }

    void printInfo(std::ostream& os) const override {
        os << "Polygon with " << points.size() << " points: ";
        for (const auto& point : points) {
            os << point << " ";
        }
        os << "| Area: " << area();
    }

    const std::vector<Point<T>>& getPoints() const { return points; }
    size_t getPointCount() const { return points.size(); }

    static int getPolygonCount() { return polygonCount; }
};

template<typename T>
int Polygon<T>::polygonCount = 0;

template<typename T>
class Triangle : public Polygon<T> {
private:
    static int triangleCount;

    void validateTriangle() const {
        if (this->points.size() != 3) {
            throw ShapeException("Triangle must have exactly 3 points");
        }

        const Point<T>& p1 = this->points[0];
        const Point<T>& p2 = this->points[1];
        const Point<T>& p3 = this->points[2];

        double a = p1.distance(p2);
        double b = p2.distance(p3);
        double c = p3.distance(p1);

        if (a + b <= c || a + c <= b || b + c <= a) {
            throw ShapeException("Invalid triangle: points are collinear or triangle is degenerate");
        }
    }
public:
    Triangle() { triangleCount++; }

    Triangle(const Point<T>& p1, const Point<T>& p2, const Point<T>& p3) {
        triangleCount++;
        this->points = { p1, p2, p3 };
        validateTriangle();
    }

    Triangle(const std::vector<Point<T>>& points) : Polygon<T>(points) {
        triangleCount++;
        validateTriangle();
    }

    Triangle(const Triangle<T>& other) : Polygon<T>(other) {
        triangleCount++;
    }

    ~Triangle() {
        triangleCount--;
    }

    Triangle<T>& operator=(const Triangle<T>& other) {
        if (this != &other) {
            Polygon<T>::operator=(other);
        }
        return *this;
    }

    double area() const override {
        const Point<T>& p1 = this->points[0];
        const Point<T>& p2 = this->points[1];
        const Point<T>& p3 = this->points[2];

        double a = p1.distance(p2);
        double b = p2.distance(p3);
        double c = p3.distance(p1);

        double s = (a + b + c) / 2.0;
        return std::sqrt(s * (s - a) * (s - b) * (s - c));
    }

    void printInfo(std::ostream& os) const override {
        os << "Triangle: ";
        for (const auto& point : this->points) {
            os << point << " ";
        }
        os << "| Area: " << area();
    }

    static int getTriangleCount() { return triangleCount; }
};

template<typename T>
int Triangle<T>::triangleCount = 0;

template<typename T>
class Rectangle : public Polygon<T> {
private:
    static int rectangleCount;

    void validateRectangle() const {
        if (this->points.size() != 4) {
            throw ShapeException("Rectangle must have exactly 4 points");
        }

        const Point<T>& p1 = this->points[0];
        const Point<T>& p2 = this->points[1];
        const Point<T>& p3 = this->points[2];
        const Point<T>& p4 = this->points[3];

        double dot1 = (p2.x - p1.x) * (p4.x - p1.x) + (p2.y - p1.y) * (p4.y - p1.y);
        if (std::abs(dot1) > 1e-6) {
            throw ShapeException("Invalid rectangle: angles are not 90 degrees");
        }
    }

public:
    Rectangle() { rectangleCount++; }

    Rectangle(const Point<T>& p1, const Point<T>& p2, const Point<T>& p3, const Point<T>& p4) {
        rectangleCount++;
        this->points = { p1, p2, p3, p4 };
        validateRectangle();
    }

    Rectangle(T x1, T y1, T x2, T y2) {
        rectangleCount++;
        this->points = {
            Point<T>(x1, y1),
            Point<T>(x2, y1),
            Point<T>(x2, y2),
            Point<T>(x1, y2)
        };
        validateRectangle();
    }

    Rectangle(const std::vector<Point<T>>& points) : Polygon<T>(points) {
        rectangleCount++;
        validateRectangle();
    }

    Rectangle(const Rectangle<T>& other) : Polygon<T>(other) {
        rectangleCount++;
    }

    ~Rectangle() {
        rectangleCount--;
    }

    Rectangle<T>& operator=(const Rectangle<T>& other) {
        if (this != &other) {
            Polygon<T>::operator=(other);
        }
        return *this;
    }

    double area() const override {
        double width = this->points[0].distance(this->points[1]);
        double height = this->points[1].distance(this->points[2]);
        return width * height;
    }

    void printInfo(std::ostream& os) const override {
        os << "Rectangle: ";
        for (const auto& point : this->points) {
            os << point << " ";
        }
        os << "| Area: " << area();
    }

    static int getRectangleCount() { return rectangleCount; }
};

template<typename T>
int Rectangle<T>::rectangleCount = 0;

template<typename T>
std::ostream& operator<<(std::ostream& os, const Polygon<T>& polygon) {
    polygon.printInfo(os);
    return os;
}

template<typename T>
std::ostream& operator<<(std::ostream& os, const Triangle<T>& triangle) {
    triangle.printInfo(os);
    return os;
}

template<typename T>
std::ostream& operator<<(std::ostream& os, const Rectangle<T>& rectangle) {
    rectangle.printInfo(os);
    return os;
}
void demonstrateExceptions() {
    std::cout << "\n=== Exception Handling Demonstration ===\n";

    try {
        try {
            std::cout << "Attempting to create degenerate triangle...\n";
            Triangle<double> badTriangle(
                Point<double>(0, 0),
                Point<double>(1, 1),
                Point<double>(2, 2)
            );
        }
        catch (const ShapeException& e) {
            std::cout << "Inner exception: " << e.what() << "\n";
            throw;
        }
    }
    catch (const ShapeException& e) {
        std::cout << "Outer exception: " << e.what() << "\n";
    }

    try {
        std::cout << "Attempting to create polygon with 2 points...\n";
        std::vector<Point<double>> twoPoints = {
            Point<double>(0, 0),
            Point<double>(1, 1)
        };
        Polygon<double> badPolygon(twoPoints);
    }
    catch (const ShapeException& e) {
        std::cout << "Exception: " << e.what() << "\n";
    }
}

int main() {
    try {
        std::cout << "=== Creating Geometric Shapes ===\n";

        Triangle<double> triangle1(
            Point<double>(0, 0),
            Point<double>(3, 0),
            Point<double>(0, 4)
        );
        std::cout << triangle1 << std::endl;

        Rectangle<double> rectangle1(0, 0, 5, 3);
        std::cout << rectangle1 << std::endl;

        std::vector<Point<double>> polyPoints = {
            Point<double>(0, 0),
            Point<double>(4, 0),
            Point<double>(4, 3),
            Point<double>(2, 5),
            Point<double>(0, 3)
        };
        Polygon<double> polygon1(polyPoints);
        std::cout << polygon1 << std::endl;

        std::cout << "\n=== Polymorphism Demonstration ===\n";
        std::vector<std::unique_ptr<Shape>> shapes;
        shapes.push_back(std::make_unique<Triangle<double>>(
            Point<double>(0, 0), Point<double>(2, 0), Point<double>(0, 2)));
        shapes.push_back(std::make_unique<Rectangle<double>>(0, 0, 4, 2));

        for (const auto& shape : shapes) {
            shape->printInfo(std::cout);
            std::cout << std::endl;
        }

        std::cout << "\n=== Object Statistics ===\n";
        std::cout << "Total shapes: " << Shape::getTotalShapes() << std::endl;
        std::cout << "Triangles: " << Triangle<double>::getTriangleCount() << std::endl;
        std::cout << "Rectangles: " << Rectangle<double>::getRectangleCount() << std::endl;
        std::cout << "Polygons: " << Polygon<double>::getPolygonCount() << std::endl;

        demonstrateExceptions();

    }
    catch (const std::exception& e) {
        std::cerr << "Unhandled exception: " << e.what() << std::endl;
        return 1;
    }

    return 0;
}
